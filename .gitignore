node_modules/
dist/
*.log
.DS_Store
Thumbs.db

# Blender working files keep their .blend but not autosaves
*.blend1
*.blend2

# Python bytecode from the Blender build scripts
__pycache__/
*.pyc

# The generated audio set is settled (40 cues / 71 files, reviewed by ear), and
# the takes are NOT reproducible - regenerating gives different audio - so it is
# tracked. Only the disposable audition page stays out.
assets/audio/_audition.html

# Source images the pilot portraits were keyed from: 14 MB, and the game only
# ever loads the processed 256/96 PNGs. Excluded pending a call on whether that
# much irreplaceable-but-large source belongs in history. BACK THIS FOLDER UP
# somewhere - regenerating it is not possible.
assets/sprites/pilots/_raw/

# Progress file written by tools/blender/rebuild_drones.py so a caller can poll
# past the MCP request timeout. Transient build state, recreated every run.
renders/debug/_drone_build_status.json

# Screenshots and sprites from the original Babel Sword 2005, used only as
# private study material (see docs/REFERENCE_ART_STUDY.md). They are another
# creator's art and must never be published, so they stay on this machine.
docs/reference/
